font-size = 14

# Available fonts: ghostty +list-fonts

# ==Comic Code config==
# font-family = Comic Code Ligatures
# font-style-bold = "SemiBold"
# font-style-bold-italic = "SemiBold Italic"
# adjust-cell-width = -10%
# adjust-cell-height = +21%
# ==Comic code end==

# ==Mono Lisa config==
font-family = MonoLisa Variable
adjust-cell-height = +6%
# font-variation = "wght=300"

# alt asterisk
font-feature = "ss01"
# # script
# font-feature = "ss02"
# # alt g
# font-feature = "ss03"
# font-feature = "ss04"
# # alt sz
# font-feature = "ss05"
# alt at
font-feature = "ss06"
# font-feature = "ss18"
# # alt curly braces
# font-feature = "ss07"
# # alt parenthesis
# font-feature = "ss08"
# alt gte symbol
# font-feature = "ss9"
font-feature = "ss10"
# alt hexadecimal
font-feature = "ss11"
# # thin backslash
# font-feature = "ss12"
# # alt dollar
# font-feature = "ss13"
# # alt ampersand
# font-feature = "ss14"
# sans-serif i
font-feature = "ss15"
# sans-serif r
font-feature = "ss16"
# # alt .= and ..=
# font-feature = "ss17"
# ==Mono Lisa end==

font-synthetic-style = false
# font-thicken = true

theme = Kanagawa Wave
window-theme = dark
minimum-contrast = 1.0
window-padding-color = extend
unfocused-split-opacity = 0.69

cursor-style = underline
cursor-style-blink = false
shell-integration-features = no-cursor

mouse-hide-while-typing = true
mouse-scroll-multiplier = 0.5
link-url = true
macos-option-as-alt = left
desktop-notifications = false
auto-update = off

# command = /opt/homebrew/bin/fish
command = /opt/homebrew/bin/fish --login -c 'sessionizer --shell'
shell-integration = fish

quit-after-last-window-closed = true
confirm-close-surface = false
window-padding-x = 0
window-padding-y = 0
window-decoration = false
# macos-titlebar-style = hidden

# background-opacity = 0.42
# background-blur-radius = 42

# disable some default keybinds
# selecting tab -- we don't have tabs
keybind = cmd+physical:zero=unbind
keybind = cmd+physical:one=unbind
keybind = cmd+physical:two=unbind
keybind = cmd+physical:three=unbind
keybind = cmd+physical:four=unbind
keybind = cmd+physical:five=unbind
keybind = cmd+physical:six=unbind
keybind = cmd+physical:seven=unbind
keybind = cmd+physical:eight=unbind
keybind = cmd+physical:nine=unbind

# closing things should be done with C-d or similar
keybind = cmd+alt+shift+w=unbind
keybind = cmd+shift+w=unbind
keybind = cmd+w=unbind

# For some reason, having the default decrase font size binding
# makes it so that no other keybinds work on cmd+minus
keybind = cmd+minus=unbind

# "presentation mode"
keybind = cmd+shift+plus=increase_font_size:22
keybind = cmd+option+shift+plus=increase_font_size:28
# so that we have decrase_font_size bound to something
keybind = cmd+option+shift+minus=decrease_font_size:1
keybind = cmd+shift+0=reset_font_size

# auto detect doesn't work because of tmux
keybind = cmd+shift+i=toggle_secure_input

# "tmux integration"
# we will rebind cmd+n to mean something else
keybind = cmd+option+n=new_window

# C-a p, prev window
keybind = cmd+left_bracket=text:\x01\x70
# C-a n, next window
keybind = cmd+right_bracket=text:\x01\x6e
# C-a c, new window
keybind = cmd+n=text:\x01\x63
# C-a ,, remane window
keybind = cmd+comma=text:\x01\x2c

# C-a |, split horizontally
keybind = cmd+shift+backslash=text:\x01\x7c
# C-a -, split vertically
keybind = cmd+shift+minus=text:\x01\x2d

# C-a C-p, prev session
keybind = cmd+shift+left_bracket=text:\x01\x10
# C-a C-n, next session
keybind = cmd+shift+right_bracket=text:\x01\x0e
# C-a C-c, switch session
keybind = cmd+ctrl+s=text:\x01\x03
keybind = cmd+shift+n=text:\x01\x03
keybind = cmd+shift+s=text:\x01\x73
