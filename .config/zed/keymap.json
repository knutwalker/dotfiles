// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "ContextEditor > Editor",
    "unbind": {
      "cmd-s": "workspace::Save",
    },
    "bindings": {
      "ctrl-s": "workspace::Save",
      "ctrl-enter": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "((((((Dock || Workspace) || OutlinePanel) || ProjectPanel) || CollabPanel) || Terminal) || (Editor && mode == auto_height))",
    "bindings": {
      "escape": "editor::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-k": "git_panel::ToggleFocus",
      "ctrl-k": "git_panel::ToggleFocus",
      "cmd-s": "workspace::Save",
    },
    "bindings": {
      "ctrl-s": "workspace::Save",
    },
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "W": "vim::NextWordStart",
      "b": "vim::PreviousSubwordStart",
      "B": "vim::PreviousWordStart",
      "e": "vim::NextSubwordEnd",
      "E": "vim::NextWordEnd",
      "g e": "vim::PreviousSubwordEnd",
      "g E": "vim::PreviousWordEnd",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_next || vim_operator == helix_previous",
    "bindings": {
      "w": "vim::Subword",
      "W": "vim::Word",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
      "shift-x": "vim::Exchange",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "z": "vim::PushSneak",
      "shift-z": "vim::PushSneakBackward",
    },
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-s": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-w": [
        "editor::DeleteToPreviousWordStart",
        {
          "ignore_newlines": false,
          "ignore_brackets": false,
        },
      ],
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist",
    },
  },
  {
    "context": "!ContextEditor && !AcpThread > Editor && mode == full",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist",
    },
  },
  {
    "context": "ContextEditor > Editor",
    "unbind": {
      "shift-enter": "assistant::Split",
    },
  },
  {
    "context": "ContextEditor > Editor",
    "unbind": {
      "cmd-enter": "assistant::Assist",
    },
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-a": "assistant::InlineAssist",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-\\": "assistant::InlineAssist",
    },
  },
  {
    "context": "ContextEditor > Editor",
    "unbind": {
      "enter": "assistant::ConfirmCommand",
    },
  },
  {
    "context": "MessageEditor > Editor && VimControl",
    "unbind": {
      "enter": "agent::Chat",
    },
  },
]
